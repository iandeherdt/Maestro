# Conventions of this repository. Written by `maestro conventions apply dotnet`.
# The agent may not change this file; change it by hand when a rule has to change.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
# Style
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_prefer_braces = true:warning

# Unused code
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# Every security rule of the .NET analyzers counts.
dotnet_analyzer_diagnostic.category-Security.severity = warning

# Size and complexity (limits in conventions/dotnet/SonarLint.xml)
dotnet_diagnostic.S104.severity = warning
dotnet_diagnostic.S138.severity = warning
dotnet_diagnostic.S3776.severity = warning
